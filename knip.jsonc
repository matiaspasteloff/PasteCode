{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/desktop": {
      // El shell falso del test del supervisor no lo importa nadie: se lo pasa
      // como ruta a `spawn`, que es justamente lo que lo hace un binario y no
      // un módulo. Knip no puede verlo y lo reportaría como muerto.
      "entry": ["src/renderer/main.tsx", "scripts/*.mjs", "src/main/**/fake-*.mjs"],
    },
    "e2e": {
      "entry": ["tests/**/*.spec.ts"],
      // El E2E no importa nada de @pastecode/desktop: lanza la app por ruta.
      // La dependencia igual es real y hace falta, porque es lo que le dice a
      // Turborepo que tiene que buildear la app antes de correr los tests
      // (el `dependsOn: ["^build"]` de turbo.json). Sacarla haría que el E2E
      // corriera contra el `out/` de la corrida anterior, o contra nada.
      "ignoreDependencies": ["@pastecode/desktop"],
    },
  },
}
