    "selection": "#434c5e",
    "focus-ring": "#88c0d0",

    "danger": "#e08890",
    "danger-subtle": "#4a353a",
    "warning": "#ebcb8b",
    "warning-subtle": "#4a422f",
    "success": "#a3be8c",
    "success-subtle": "#37432f",
    "info": "#81a1c1",
    "info-subtle": "#33404a",

    "git-added": "#a3be8c",
    "git-modified": "#ebcb8b",
    "git-deleted": "#e08890",
    "git-untracked": "#8fbcbb",
    "git-conflict": "#de9b84",

    "icon-code": "#88c0d0",
