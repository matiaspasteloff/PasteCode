{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // vite/client aporta las declaraciones de los imports de CSS y de assets.
    "types": ["vite/client"]
  },
  // El setup de los tests de renderer entra acá y no en el proyecto de Node:
  // corre en jsdom y toca `HTMLElement`, así que necesita la lib del DOM. Sin
  // incluirlo, ESLint no lo encuentra en ningún proyecto y no puede lintearlo.
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "vitest.setup.tsx"]
}
