{
  "name": "@pastecode/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Aplicación Electron de PasteCode.",
  "license": "MIT",
  "author": "Matías Pasteloff",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/install-electron-binary.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "package": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "devDependencies": {
    "@pastecode/core": "workspace:*",
    "@pastecode/extension-api": "workspace:*",
    "@pastecode/extension-host": "workspace:*",
    "@pastecode/ipc-contract": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/debugprotocol": "1.68.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vscode-jsonrpc": "8.2.1",
    "vscode-languageserver-protocol": "3.17.5"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "@tanstack/react-virtual": "3.14.9",
    "@vscode/ripgrep": "1.18.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "4.0.3",
    "monaco-editor": "0.56.0",
    "typescript-language-server": "5.0.0",
    "zustand": "5.0.15"
  }
}
