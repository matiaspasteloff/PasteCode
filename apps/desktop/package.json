{
  "name": "@pastecode/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación Electron de PasteCode.",
  "license": "MIT",
  "author": "Matías Pasteloff",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/install-electron-binary.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "package": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "devDependencies": {
    "@pastecode/core": "workspace:*",
    "@pastecode/ipc-contract": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "zustand": "5.0.15"
  }
}
